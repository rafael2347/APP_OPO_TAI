{
  "expo": {
    "name": "tai",
    "slug": "tai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IconTai.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/IconTai.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myapp.taiapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/IconTai.png"
      },
      "package": "com.myapp.taiapp"
    },
    "web": {
      "favicon": "./assets/IconTai.png"
    },
    "extra": {
      "eas": {
        "projectId": "5f87cd7c-03c4-4152-8160-e63d31dfb535"
      }
    }
  }
}
